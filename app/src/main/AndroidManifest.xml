<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Consulta si hay un motor de texto-a-voz instalado (obligatorio en Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      Sin copia de seguridad: ni fotos, ni ajustes, ni favoritos, ni pictogramas
      propios salen del teléfono. Las fotos pueden mostrar la casa o los objetos
      del chico, y Recientes y Favoritos son lo que dice.

      Hacen falta las dos piezas. allowBackup="false" apaga la copia en la nube,
      pero desde Android 12 NO apaga la transferencia a un teléfono nuevo: esa
      la cierran las exclusiones de data_extraction_rules.xml.

      Costo conocido: al cambiar de teléfono o reinstalar se pierde todo lo
      personalizado. Un respaldo elegido por la familia queda para otra fase.
    -->
    <application
        android:name=".AgustiSpeaksApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgustiSpeaks"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AgustiSpeaks">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Le presta a la cámara un archivo donde escribir la foto de un
          pictogift. No agrega ningún permiso: la cámara la abre el sistema, y
          la app nunca declara CAMERA.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>

    </application>

</manifest>
