<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 o anterior. Con allowBackup="false" en el manifiesto este archivo
  no se consulta; las exclusiones están igual, para que si alguien vuelve a
  activar la copia, siga sin incluir nada hasta que se decida qué respaldar.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
