<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tunombre.agustispeaks"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Consulta si hay un motor de texto-a-voz instalado (obligatorio en Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <permission
        android:name="com.tunombre.agustispeaks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.tunombre.agustispeaks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <!--
      Sin copia de seguridad: ni fotos, ni ajustes, ni favoritos, ni pictogramas
      propios salen del teléfono. Las fotos pueden mostrar la casa o los objetos
      del chico, y Recientes y Favoritos son lo que dice.

      Hacen falta las dos piezas. allowBackup="false" apaga la copia en la nube,
      pero desde Android 12 NO apaga la transferencia a un teléfono nuevo: esa
      la cierran las exclusiones de data_extraction_rules.xml.

      Costo conocido: al cambiar de teléfono o reinstalar se pierde todo lo
      personalizado. Un respaldo elegido por la familia queda para otra fase.
    -->
    <application
        android:name="com.tunombre.agustispeaks.AgustiSpeaksApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.AgustiSpeaks" >
        <activity
            android:name="com.tunombre.agustispeaks.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AgustiSpeaks" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Le presta a la cámara un archivo donde escribir la foto de un
          pictogift. No agrega ningún permiso: la cámara la abre el sistema, y
          la app nunca declara CAMERA.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tunombre.agustispeaks.fotos"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tunombre.agustispeaks.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>